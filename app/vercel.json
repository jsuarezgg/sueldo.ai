{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/uso.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    },
    {
      "source": "/ai.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/compare",
      "destination": "/api/compare?format=html"
    }
  ],
  "redirects": [
    {
      "source": "/chatgpt",
      "destination": "/ai",
      "permanent": true
    },
    {
      "source": "/chatgpt.md",
      "destination": "/ai.md",
      "permanent": true
    }
  ]
}
